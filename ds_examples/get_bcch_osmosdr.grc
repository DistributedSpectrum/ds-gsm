options:
  parameters:
    author: Bradley C.
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: get_bcch_osmosdr
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'GSM BCCH Decoder OsmoSDR/SigMF '
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [0, 4.0]
    rotation: 0
    state: enabled

blocks:
- name: input_rx_freq
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 1,0,1,3
    label: 'RX Center Freq '
    type: real
    value: fc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 124.0]
    rotation: 0
    state: enabled
- name: input_sigmf
  id: variable
  parameters:
    comment: ''
    value: '"../test_data/sms_downlink_tail"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1024, 20.0]
    rotation: 0
    state: enabled
- name: input_sigmf_entry
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 0,0,1,6
    label: SigMF Data filepath
    type: string
    value: input_file_name
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 108.0]
    rotation: 0
    state: enabled
- name: sdr_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,3,1,3
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '-16'
    step: '1'
    stop: '60'
    value: rx_gain
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 108.0]
    rotation: 0
    state: enabled
