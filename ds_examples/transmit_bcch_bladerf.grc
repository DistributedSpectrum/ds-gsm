    fpga_image: ''
    fpga_reload: 'False'
    freq: freq_tx
    gain0: tx_gain
    gain1: '10'
    if_gain0: tx_gain
    if_gain1: '20'
    in_clk: ONBOARD
    iq_gain0: '0'
    iq_gain1: '0'
    iq_phase0: '0'
    iq_phase1: '0'
    lpf_mode: disabled
    maxoutbuf: '0'
    metadata: 'False'
    minoutbuf: '0'
    nchan: '1'
    out_clk: 'False'
    ref_clk: 10e6
    sample_format: 16bit
