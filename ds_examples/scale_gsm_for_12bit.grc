options:
  parameters:
    author: Bradley C.
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Use this function to read in a cfile IQ file and scale it for bladeRF
      12bit. Hit write sigmf checkbox to lock in data
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: scale_gsm_for_12bit
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Scale cfile to 12bit
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: bcc_tch_filter
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    'false': '0'
    gui_hint: 2,2,1,1
    label: Channel Filter (BCCH/TCH) Select
    'true': '1'
    type: int
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [496, 164.0]
    rotation: 0
    state: enabled
- name: filter_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 2,0,1,2
    label: filt_gain
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '1'
    step: '1'
    stop: '300'
    value: '29'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 12.0]
    rotation: 0
    state: enabled
- name: gsm_sample_rate
  id: variable
  parameters:
    comment: ''
    value: (270.8334e3 + 8e3)/2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 76.0]
    rotation: 0
    state: enabled
- name: input_cfile_entry
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 0,0,1,2
    label: Cfile Data filepath
    type: string
    value: input_file_name
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 28.0]
    rotation: 0
    state: enabled
- name: n_iq
  id: variable
  parameters:
    comment: ''
    value: int(os.path.getsize(input_cfile_entry) // gr.sizeof_gr_complex)*2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 28.0]
    rotation: 0
    state: enabled
- name: os
  id: variable
  parameters:
    comment: ''
    value: __import__('os')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 124.0]
    rotation: 0
    state: enabled
- name: output_sigmf_entry
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 0,2,1,2
    label: SigMf Data outpath
    type: string
    value: output_file_name
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 164.0]
    rotation: 0
    state: enabled
- name: sample_rate_switch
  id: variable_qtgui_toggle_switch
  parameters:
    cellalignment: '1'
    comment: ''
    gui_hint: 1,2,1,1
    initPressed: 'False'
    label: BCCH/TCH Fs
    outputmsgname: pmt.to_pmt(True)
    position: '4'
    pressed: 100.0e6/174
    released: 1e6
    switchOffBackground: gray
    switchOnBackground: green
    type: real
    value: samp_rate_in
    verticalalignment: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [152, 228.0]
    rotation: 0
    state: enabled
- name: variable_qtgui_entry_0
  id: variable_qtgui_entry
